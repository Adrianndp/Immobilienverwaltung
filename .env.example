POSTGRES_DB=immobilienverwaltung
POSTGRES_USER=immobilienverwaltung
POSTGRES_PASSWORD=immobilienverwaltung
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Django. Production: new random secret key, DJANGO_DEBUG=False, your domain(s).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Production only (docker-compose.prod.yml): host port for nginx.
NGINX_PORT=80
